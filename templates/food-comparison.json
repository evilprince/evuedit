{
  "id": "food-comparison",
  "version": 1,
  "description": "Split-screen layout for budget-versus-premium or before-versus-after food comparisons.",
  "canvas": {
    "youtube": {
      "width": 1280,
      "height": 720
    },
    "instagram": {
      "width": 1080,
      "height": 1920
    },
    "facebook": {
      "width": 1080,
      "height": 1920
    },
    "facebook-video": {
      "width": 1280,
      "height": 720,
      "aspectRatio": "16:9"
    },
    "facebook-feed": {
      "width": 1080,
      "height": 1350,
      "aspectRatio": "4:5"
    },
    "facebook-square": {
      "width": 1080,
      "height": 1080,
      "aspectRatio": "1:1"
    },
    "facebook-reels": {
      "width": 1080,
      "height": 1920,
      "aspectRatio": "9:16"
    },
    "facebook-link-preview": {
      "width": 1200,
      "height": 630,
      "aspectRatio": "1.91:1"
    }
  },
  "layout": {
    "imageMode": "split-cover",
    "splitDirection": "vertical",
    "splitRatio": 0.5,
    "leftLabel": "BUDGET",
    "rightLabel": "PREMIUM",
    "leftLabelColor": "#FFD43B",
    "rightLabelColor": "#FFFFFF",
    "headlinePosition": "top-center",
    "headlineMaxLines": 2,
    "headlineMaxWords": 5,
    "font": "assets/fonts/Anton-Regular.ttf",
    "fontSizeRatio": 0.082,
    "textColor": "#FFFFFF",
    "accentColor": "#FFD43B",
    "shadow": true,
    "divider": true,
    "dividerColor": "#FFFFFF",
    "dividerWidthRatio": 0.006,
    "labelBackground": "#171717",
    "border": false
  },
  "export": {
    "format": "jpeg",
    "quality": 92,
    "colorSpace": "sRGB"
  }
}
