{
  "id": "youtube-review",
  "version": 1,
  "description": "High-impact 16:9 thumbnail for a food or restaurant review.",
  "canvas": {
    "youtube": {
      "width": 1280,
      "height": 720
    },
    "instagram": {
      "width": 1080,
      "height": 1920
    }
  },
  "layout": {
    "imageMode": "cover",
    "subjectPosition": "right",
    "gradient": "left-to-right",
    "headlinePosition": "left-center",
    "headlineMaxLines": 3,
    "headlineMaxWords": 5,
    "font": "assets/fonts/Anton-Regular.ttf",
    "fontSizeRatio": 0.095,
    "textColor": "#FFFFFF",
    "accentColor": "#FFD43B",
    "shadow": true,
    "labelText": "FOOD REVIEW",
    "labelPosition": "top-left",
    "labelBackground": "#D62828",
    "border": false
  },
  "export": {
    "format": "jpeg",
    "quality": 92,
    "colorSpace": "sRGB"
  }
}
