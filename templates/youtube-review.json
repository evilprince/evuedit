{
  "id": "youtube-review",
  "version": 1,
  "description": "High-impact 16:9 thumbnail for a food or restaurant review.",
  "canvas": {
    "youtube": {
      "width": 1280,
      "height": 720
    },
    "instagram": {
      "width": 1080,
      "height": 1920
    },
    "facebook": {
      "width": 1080,
      "height": 1920
    },
    "facebook-video": {
      "width": 1280,
      "height": 720,
      "aspectRatio": "16:9"
    },
    "facebook-feed": {
      "width": 1080,
      "height": 1350,
      "aspectRatio": "4:5"
    },
    "facebook-square": {
      "width": 1080,
      "height": 1080,
      "aspectRatio": "1:1"
    },
    "facebook-reels": {
      "width": 1080,
      "height": 1920,
      "aspectRatio": "9:16"
    },
    "facebook-link-preview": {
      "width": 1200,
      "height": 630,
      "aspectRatio": "1.91:1"
    }
  },
  "layout": {
    "imageMode": "cover",
    "subjectPosition": "right",
    "gradient": "left-to-right",
    "headlinePosition": "left-center",
